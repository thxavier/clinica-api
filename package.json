{
  "name": "clinica-api",
  "version": "1.0.0",
  "description": "API RESTful para clínica médica",
  "main": "server.js",
 "scripts": {
  "start": "node server.js",
  "dev": "node --watch server.js",
  "lint": "eslint src/ tests/ --ext .js",
  "test": "jest --testPathPattern=\"tests/(pacientes|consultas)\\.test\\.js\"",
  "test:coverage": "jest --testPathPattern=\"tests/(pacientes|consultas)\\.test\\.js\" --coverage",
  "test:selenium": "jest --testPathPattern=\"tests/selenium\\.test\\.js\" --testTimeout=30000"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/database/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "selenium-webdriver": "^4.45.0",
    "supertest": "^7.2.2"
  }
}
